{
  "version": 2,
  "builds": [
    { "src": "single.js", "use": "@vercel/node", "config": { "includeFiles": "documents/**" } },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/single.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
